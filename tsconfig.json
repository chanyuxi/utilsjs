{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@tsconfig/recommended/tsconfig.json"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true
  },
  "include": ["src", "build", "test", "rollup.config.ts", "commitlint.config.ts"]
}
